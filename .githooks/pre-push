#!/bin/sh
while read local_ref local_oid remote_ref remote_oid
do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master|refs/heads/release/*|refs/tags/*)
      echo "Direct protected-branch/tag pushes are blocked. Use a PR and verify its latest head checks before merge/release." >&2
      exit 1
      ;;
  esac
done
