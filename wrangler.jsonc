{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "videosreeeen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/ws", "/healthz", "/config", "/cache-plan/*", "/media/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "WatchRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WatchRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "https://videosreeeen.local,null,file://" },
  "observability": { "enabled": false }
}
